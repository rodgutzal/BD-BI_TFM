# .env.example — BD_BI_TFM
# Copia este archivo como `.env` y completa tus claves reales.
# `.env` está en .gitignore: nunca se sube al repositorio.

# --- Fuente de datos de tráfico ---
# 'ors'    -> OpenRouteService (gratis, sin datos de tráfico en tiempo real)
# 'tomtom' -> TomTom (requiere clave, sí reporta tráfico en tiempo real)
DATA_SOURCE=ors

# --- Claves de API ---
# OpenRouteService: https://openrouteservice.org/dev/#/signup (gratis)
ORS_API_KEY=tu_clave_ors_aqui

# TomTom: https://developer.tomtom.com/ (solo necesaria si DATA_SOURCE=tomtom)
TOMTOM_API_KEY=tu_clave_tomtom_aqui

# OpenWeather: https://openweathermap.org/api (gratis, siempre necesaria)
OPENWEATHER_API_KEY=tu_clave_openweather_aqui

# --- TimescaleDB (capa de producción) ---
# Estos valores coinciden con los defaults de docker-compose.yml.
# Dentro de Docker, docker-compose sobreescribe PGHOST=timescaledb
# automáticamente; PGHOST=localhost solo aplica si corres el collector o
# el dashboard fuera de Docker, en tu propia máquina.
PGHOST=localhost
PGPORT=5432
PGDATABASE=movilidad_urbana
PGUSER=postgres
PGPASSWORD=cambia_esto_por_algo_fuerte

# --- pgAdmin y sqlite-web (herramientas de administración) ---
# Genera valores propios, por ejemplo:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))"
PGADMIN_PASSWORD=cambia_esto_por_algo_fuerte
SQLITE_WEB_PASSWORD=cambia_esto_por_algo_fuerte
